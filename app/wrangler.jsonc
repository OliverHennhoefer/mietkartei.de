// Configuration for the cloudflare target (DEPLOY_TARGET=cloudflare). The App workflow deploys it
// to app.mietkartei.de; locally it runs the built app in workerd with a local D1 and R2.
{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "mietkartei-app",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_als"],
	"routes": [{ "pattern": "app.mietkartei.de", "custom_domain": true }],
	// Registration is closed: only the addresses of the secret REGISTRATION_EMAILS may register.
	// See src/lib/server/registration.ts and .github/DEPLOYMENT.md.
	// Mails (password reset, invitations) go out through Resend; the API key is the secret
	// MAIL_API_KEY, see .github/DEPLOYMENT.md.
	// The Verbraucherpreisindex comes from Destatis with the API token of the secret
	// GENESIS_API_TOKEN, see src/lib/server/consumer-price-index.ts and .github/DEPLOYMENT.md.
	// The subscription is on once the secrets STRIPE_SECRET_KEY and STRIPE_WEBHOOK_SECRET are set
	// as well; STRIPE_PRICE_ID is the monthly price in Stripe test mode. STRIPE_YEARLY_PRICE_ID
	// adds the yearly plan once it is set. See .github/DEPLOYMENT.md.
	// HOSTED marks app.mietkartei.de and its demo, unlike a self-hosted copy on Cloudflare, which
	// deploys ../wrangler.jsonc; see docs/selbst-hosten.md.
	"vars": {
		"HOSTED": "true",
		"MAIL_TRANSPORT": "resend",
		"MAIL_FROM": "noreply@mietkartei.de",
		"STRIPE_PRICE_ID": "price_1UTPZ8HkVR9ErMZWMjxrzJPD"
	},
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	// A request may use at most 10 s of CPU instead of the default 30 s. The slowest real path, a
	// bank import of a 2 MB file (~27,000 rows), takes about 1 s each for preview and commit.
	"limits": { "cpu_ms": 10000 },
	// Posts of the sign-in, registration, reset and invitation forms per client address, and calls
	// of the API; see src/lib/server/rate-limit.
	"ratelimits": [
		{ "name": "AUTH_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
		// Calls of the API and the MCP server per key, and calls with a wrong key per address.
		{ "name": "API_LIMITER", "namespace_id": "1002", "simple": { "limit": 120, "period": 60 } }
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "mietkartei",
			// The hosted database, created with jurisdiction "eu". See .github/DEPLOYMENT.md.
			"database_id": "08298e4f-d84f-403b-acd0-5ca38c86c052",
			"migrations_dir": "drizzle"
		}
	],
	"r2_buckets": [
		{
			// Uploaded documents. The hosted bucket must exist before the first deployment with it,
			// see .github/DEPLOYMENT.md; locally wrangler keeps it on disk.
			"binding": "DOCUMENTS",
			"bucket_name": "mietkartei-documents",
			"jurisdiction": "eu"
		},
		{
			// The street map of Germany for the map previews of the properties, uploaded by the
			// Map workflow (.github/workflows/map.yml). The deploy job creates the bucket when it
			// is missing; until the first upload the previews show the outline of Germany.
			"binding": "MAP",
			"bucket_name": "mietkartei-map",
			"jurisdiction": "eu"
		}
	],
	// The public demo at demo.mietkartei.de, deployed with `wrangler deploy --env demo` after the
	// app. Every visitor gets a throwaway account (DEMO, see src/lib/server/demo-accounts.ts); mails
	// stay in the outbox table and are never sent. The deploy job creates the bucket when it is
	// missing.
	"env": {
		"demo": {
			"name": "mietkartei-demo",
			"routes": [{ "pattern": "demo.mietkartei.de", "custom_domain": true }],
			"vars": {
				"HOSTED": "true",
				"DEMO": "true",
				"MAIL_TRANSPORT": "outbox",
				"MAIL_FROM": "noreply@mietkartei.de",
				// No subscription in the demo.
				"STRIPE_PRICE_ID": ""
			},
			"ratelimits": [
				{ "name": "AUTH_LIMITER", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } }
			],
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "mietkartei-demo",
					"database_id": "454147c0-ec65-4c1f-97d3-be5ce42d3691",
					"migrations_dir": "drizzle"
				}
			],
			"r2_buckets": [
				{
					"binding": "DOCUMENTS",
					"bucket_name": "mietkartei-demo-documents",
					"jurisdiction": "eu"
				},
				// The demo reads the same street map as the app.
				{ "binding": "MAP", "bucket_name": "mietkartei-map", "jurisdiction": "eu" }
			]
		}
	}
}
