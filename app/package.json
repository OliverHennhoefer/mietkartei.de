{
	"name": "mietkartei-app",
	"private": true,
	"version": "0.1.0",
	"license": "AGPL-3.0-only",
	"type": "module",
	"engines": {
		"node": ">=22.12"
	},
	"scripts": {
		"dev": "vite dev",
		"dev:cloudflare": "npm run db:migrate:d1 && DEPLOY_TARGET=cloudflare vite dev",
		"build": "vite build",
		"build:cloudflare": "DEPLOY_TARGET=cloudflare vite build",
		"preview": "vite preview",
		"start": "node server.js",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:unit": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "playwright test",
		"screenshots": "node scripts/screenshots.js",
		"social-images": "node scripts/social-images.js",
		"db:generate": "drizzle-kit generate",
		"db:migrate:d1": "wrangler d1 migrations apply DB --local",
		"db:studio": "drizzle-kit studio"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@mapbox/vector-tile": "^3.0.0",
		"bankdata-germany": "^2.2602.0",
		"better-sqlite3": "^13.0.2",
		"drizzle-orm": "^0.45.2",
		"fflate": "^0.8.3",
		"leaflet": "^1.9.4",
		"pbf": "^5.1.2",
		"pdf-lib": "^1.17.1",
		"pmtiles": "^4.5.0"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20261023.1",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-cloudflare": "^8.0.1",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/better-sqlite3": "^9.6.0",
		"@types/leaflet": "^1.9.22",
		"@types/node": "^26.6.5",
		"@vitest/coverage-v8": "^5.0.5",
		"drizzle-kit": "^0.31.10",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"fast-check": "^4.10.2",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.0",
		"vite": "^8.3.5",
		"vitest": "^5.0.5",
		"wrangler": "^4.152.0"
	},
	"overrides": {
		"@esbuild-kit/core-utils": {
			"esbuild": "^0.25.12"
		},
		"undici": "^7.30.1"
	}
}
